{
  "name": "snapback",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Fast, local image feedback for artists. Built with Tauri and Rust.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "tauri dev",
    "dist": "tauri build --config src-tauri/tauri.local.conf.json",
    "test": "vitest run tests/model.test.ts",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "dist:release": "tauri build",
    "release:version": "node scripts/release-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
