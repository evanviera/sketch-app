{
  "name": "snapback",
  "version": "0.1.0",
  "description": "Snapback – a minimal macOS screenshot annotator built with Electron",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/renderer && cp src/renderer/index.html dist/renderer/index.html && cp src/renderer/styles.css dist/renderer/styles.css && cp src/renderer/icon.svg dist/renderer/icon.svg",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^39.2.1",
    "@types/electron": "^1.6.10",
    "@types/node": "^20.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.4.0"
  },
  "build": {
    "appId": "com.example.snapback",
    "productName": "Snapback",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.graphics-design"
    }
  }
}
