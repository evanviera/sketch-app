{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapback",
  "version": "0.3.2",
  "identifier": "com.evanviera.snapback",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Snapback",
        "width": 1280,
        "height": 840,
        "minWidth": 850,
        "minHeight": 580,
        "backgroundColor": "#151515",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://use.typekit.net https://p.typekit.net; font-src 'self' https://use.typekit.net; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Open. Annotate. Send it back.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGNTYxQjVCNjhEMjEzQTMKUldTakU5Sm9XeHRXWDRrVEUrSVdTdjRYOFEvZmNXeXlONkdvL096Q0FVQ21OVWVVeTVFY3I5TEsK",
      "endpoints": [
        "https://forme.md/update/snapback/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/evanviera/sketch-app/releases/latest/download/latest.json"
      ]
    }
  }
}
